# Copy this file to .env and fill in the values.
# The API validates these variables at startup and refuses to boot if any are invalid.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGODB_URL=mongodb://localhost:27017/pass-manager
# Secret used to sign JWTs. At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# --- Optional ---------------------------------------------------------------
# Access token lifetime in minutes (default: 15) and refresh token lifetime in days (default: 7)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie. COOKIE_SECURE defaults to true only in production (HTTPS).
# Use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) only if the front end is on another site.
# COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
# Per-IP rate limits (requests per window) and per-account lockout after failed sign-ins
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# development | test | production (default: development)
NODE_ENV=development
# HTTP port (default: 3000)
PORT=3000
# Trust the X-Forwarded-* headers set by a reverse proxy (default: false)
USE_PROXY=false
# Front-end URL, used for redirects after Google sign-in (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (default: FRONTEND_URL)
CORS_ORIGINS=

# Google OAuth. Leave empty to disable "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
