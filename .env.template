# Copy this file to .env and fill in the values.
# The API validates these variables at startup and refuses to boot if any are invalid.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGODB_URL=mongodb://localhost:27017/pass-manager
# Secret used to sign JWTs. At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# --- Optional ---------------------------------------------------------------
# development | test | production (default: development)
NODE_ENV=development
# HTTP port (default: 3000)
PORT=3000
# Trust the X-Forwarded-* headers set by a reverse proxy (default: false)
USE_PROXY=false
# Front-end URL, used for redirects after Google sign-in (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (default: FRONTEND_URL)
CORS_ORIGINS=

# Google OAuth. Leave empty to disable "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
