				"description": "Request body to add a field value to one of the caller's vaults.",
				"properties": {
					"field": {
						"type": "string",
						"description": "Id of the field definition."
					},
					"value": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"type": "array"
							}
						]
					},
					"vault": {
						"type": "string",
						"description": "Id of a vault owned by the caller."
					}
				},
				"required": [
					"field",
					"value",
					"vault"
				],
				"type": "object",
				"additionalProperties": false
			},
			"INoteModel": {
