	"info": {
		"title": "Pass Manager API",
		"version": "1.1.0",
		"description": "REST API of Pass Manager. Every route except register, login, refresh, logout and Google sign-in requires a Bearer access token.",
		"license": {
			"name": "ISC"
		},
		"contact": {
			"name": "@jcesarc"
		}
	},
	"openapi": "3.0.0",
	"paths": {
		"/api/v1/auth/register": {
			"post": {
				"operationId": "RegisterUser",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {}
							}
						}
					}
				},
				"tags": [
					"AuthController"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RegisterUserInput"
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/login": {
			"post": {
				"operationId": "LoginUser",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"user": {
											"$ref": "#/components/schemas/IUserResponseModel"
										},
										"expiresIn": {
											"type": "number",
											"format": "double"
										},
										"tokenType": {
											"type": "string",
											"enum": [
												"Bearer"
											],
											"nullable": false
										},
										"accessToken": {
											"type": "string"
										},
										"refreshToken": {
											"$ref": "#/components/schemas/IssuedRefreshToken"
										}
									},
									"required": [
										"user",
										"expiresIn",
										"tokenType",
										"accessToken",
										"refreshToken"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"description": "Returns a short-lived access token in the body. The refresh token is\nonly sent as an httpOnly cookie scoped to /api/v1/auth.",
				"tags": [
					"AuthController"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/IAuthCredentials"
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/refresh": {
			"post": {
				"operationId": "RefreshSession",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"expiresIn": {
											"type": "number",
											"format": "double"
										},
										"tokenType": {
											"type": "string",
											"enum": [
												"Bearer"
											],
											"nullable": false
										},
										"accessToken": {
											"type": "string"
										},
										"refreshToken": {
											"properties": {
												"expiresAt": {
													"type": "string",
													"format": "date-time"
												},
												"token": {
													"type": "string"
												}
											},
											"required": [
												"expiresAt",
												"token"
											],
											"type": "object"
										}
									},
									"required": [
										"expiresIn",
										"tokenType",
										"accessToken",
										"refreshToken"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"description": "Rotates the refresh token cookie and returns a new access token.",
				"tags": [
					"AuthController"
				],
				"security": [],
				"parameters": []
			}
		},
		"/api/v1/auth/oauth/exchange": {
			"post": {
				"operationId": "ExchangeOAuthCode",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"user": {
											"$ref": "#/components/schemas/IUserResponseModel"
										},
										"expiresIn": {
											"type": "number",
											"format": "double"
										},
										"tokenType": {
											"type": "string",
											"enum": [
												"Bearer"
											],
											"nullable": false
										},
										"accessToken": {
											"type": "string"
										},
										"refreshToken": {
											"$ref": "#/components/schemas/IssuedRefreshToken"
										}
									},
									"required": [
										"user",
										"expiresIn",
										"tokenType",
										"accessToken",
										"refreshToken"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"description": "Completes a Google sign-in: exchanges the single-use code received by\nthe front end for a session (same response as login).",
				"tags": [
					"AuthController"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"code": {
										"type": "string"
									}
								},
								"required": [
									"code"
								],
								"type": "object"
							}
						}
					}
				}
			}
		},
		"/api/v1/auth/logout": {
			"post": {
				"operationId": "LogoutUser",
				"responses": {
					"204": {
						"description": "No content"
					}
				},
				"description": "Revokes the current session and clears the refresh token cookie.",
				"tags": [
					"AuthController"
				],
				"security": [],
				"parameters": []
			}
		},
