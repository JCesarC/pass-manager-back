{
  "name": "pass-manager-back",
  "version": "1.0.0",
  "description": "Node.js + Express + Typescript + Mongodb + Swagger ",
  "main": "src/server.js",
  "scripts": {
    "swagger": "tsoa spec-and-routes",
    "test-webpack": "npx webpack --mode production",
    "build": "npm run swagger && npx webpack --mode production",
    "build-dev": "npx webpack --mode development",
    "test": "jest",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -x tsoa spec-and-routes\" \"nodemon -q dist/src/server.js\"",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "serve:coverage": "npm run test && cd coverage/lcov-report && npx serve",
    "format": "prettier --write .",
    "deploy": "npm run build --prefix ../pass-manager && npm run build && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git@personal:JCesarC/pass-manager-back.git"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb"
  ],
  "author": "@jcesarc",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "esbuild": "^0.15.12",
    "express": "^4.18.1",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.6.5",
    "morgan": "^1.10.0",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "swagger-jsdoc": "^6.2.5",
    "swagger-ui-express": "^4.5.0",
    "tsoa": "^4.1.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.1.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.8.3",
    "@types/passport": "^1.0.12",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "concurrently": "^7.4.0",
    "esbuild-loader": "^2.20.0",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "jest": "^29.1.2",
    "nodemon": "^2.0.20",
    "prettier": "^2.7.1",
    "serve": "^14.2.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.0.3",
    "ts-loader": "^9.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-node-externals": "^3.0.0",
    "webpack-shell-plugin": "^0.5.0"
  }
}
