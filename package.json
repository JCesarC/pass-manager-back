{
  "name": "pass-manager-back",
  "version": "1.1.0",
  "description": "Node.js + Express + Typescript + Mongodb + Swagger ",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "concurrently -r \"tsnd --respawn --clear src/index.ts\" \"npm run swagger:watch\"",
    "build": "npm run clean && npm run swagger && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "clean": "rimraf ./dist",
    "swagger": "tsoa spec",
    "swagger:watch": "nodemon -x tsoa spec",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@personal:JCesarC/pass-manager-back.git"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb"
  ],
  "author": "@jcesarc",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.350.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.1",
    "helmet": "^8.3.0",
    "inversify": "^6.0.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.6.5",
    "mongoose-autopopulate": "^1.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "multer-s3": "^3.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.3",
    "@types/multer": "^2.3.0",
    "@types/multer-s3": "^3.0.0",
    "@types/node": "^18.8.3",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^7.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^29.1.2",
    "nodemon": "^2.0.20",
    "prettier": "^3.10.1",
    "rimraf": "^5.0.1",
    "supertest": "^6.3.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
